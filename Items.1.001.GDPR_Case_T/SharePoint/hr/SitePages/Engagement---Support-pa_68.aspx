mp;#58;&amp;#123;&amp;quot;zoneEmphasis&amp;quot;&amp;#58;0&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;618f2064-9261-4c40-8a3f-5caecb1d16ba&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;div class=&quot;imagePlugin&quot; style=&quot;background-color&amp;#58;transparent;position&amp;#58;relative;&quot; data-alignment=&quot;Center&quot; data-imagenaturalheight=&quot;365&quot; data-imagenaturalwidth=&quot;400&quot; data-imageurl=&quot;/sites/hr/SiteAssets/SitePages/Engagement---Support-pa/3891184105.png&quot; data-listid=&quot;197f5e2d-1aff-4cc3-a8aa-9f331dddee1f&quot; data-overlaystylesisbold=&quot;false&quot; data-overlaystylesisitalic=&quot;false&quot; data-overlaystylesoverlaycolor=&quot;light&quot; data-overlaystylesoverlaytransparency=&quot;0&quot; data-overlaystylestextboxcolor=&quot;dark&quot; data-overlaystylestextboxopacity=&quot;0.54&quot; data-overlaystylestextcolor=&quot;light&quot; data-overlaytextstyles=&quot;&amp;#123;&amp;quot;textColor&amp;quot;&amp;#58;&amp;quot;light&amp;quot;,&amp;quot;isBold&amp;quot;&amp;#58;false,&amp;quot;isItalic&amp;quot;&amp;#58;false,&amp;quot;textBoxColor&amp;quot;&amp;#58;&amp;quot;dark&amp;quot;,&amp;quot;textBoxOpacity&amp;quot;&amp;#58;0.54,&amp;quot;overlayColor&amp;quot;&amp;#58;&amp;quot;light&amp;quot;,&amp;quot;overlayTransparency&amp;quot;&amp;#58;0&amp;#125;&quot; data-siteid=&quot;4933b140-c91f-40a6-9786-f906dca179a1&quot; data-uniqueid=&quot;80b2052b-6dc4-45c9-8c13-808d825a709d&quot; data-webid=&quot;651ea5e2-4134-4a54-bcfd-728ff02e3f5e&quot; data-height=&quot;173.375&quot; data-width=&quot;190&quot; data-widthpercentage=&quot;33.56890459363957&quot; data-uploading=&quot;0&quot;&gt;&lt;/div&gt;&lt;h2 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;text-align&amp;#58;center;&quot;&gt;&lt;span class=&quot;fontSizeXLargePlus&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;&lt;strong&gt;What Engagement Pulse Survey?&amp;#160;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;Epical Engagement Pulse Survey is a short, confidential check-in to help us understand how employees are feeling about their work environment- what is working well and where we can further improve.&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;ul class=&quot;customListStyle&quot; style=&quot;list-style-type&amp;#58;disc;&quot;&gt;&lt;li&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;The survey is sent out bi-weekly from our Talent Manager portal and the questions vary for each recipient.&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;Team results are visible for each team member in the Talent Manager Engagement module, when there is min. 5 respondents.&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;The overall Epical company results are viewed quarterly in our joint Nordic Town Hall meetings.&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;margin-left&amp;#58;0in;&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;The surveys gather quantitative data but also allow employees to comment questions anonymously. The comments are visible to leaders and P&amp;amp;C despite the number of answers.&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-sp-canvascontrol=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;3,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;f9a9564c-8d64-4bab-9302-8d0451220ca4&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;2,&amp;quot;sectionFactor&amp;quot;&amp;#58;6,&amp;quot;controlIndex&amp;quot;&amp;#58;1&amp;#125;,&amp;quot;emphasis&amp;quot;&amp;#58;&amp;#123;&amp;quot;zoneEmphasis&amp;quot;&amp;#58;0&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;79e3896b-401a-4224-bcb2-b8c089413509&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;div class=&quot;imagePlugin&quot; style=&quot;background-color&amp;#58;transparent;position&amp;#58;relative;&quot; data-alignment=&quot;Center&quot; data-imagenaturalheight=&quot;328&quot; data-imagenaturalwidth=&quot;331&quot; data-imageurl=&quot;/sites/hr/SiteAssets/SitePages/Engagement---Support-pa/2692906853-epi2.png&quot; data-listid=&quot;197f5e2d-1aff-4cc3-a8aa-9f331dddee1f&quot; data-overlaystylesisbold=&quot;false&quot; data-overlaystylesisitalic=&quot;false&quot; data-overlaystylesoverlaycolor=&quot;light&quot; data-overlaystylesoverlaytransparency=&quot;0&quot; data-overlaystylestextboxcolor=&quot;dark&quot; data-overlaystylestextboxopacity=&quot;0.54&quot; data-overlaystylestextcolor=&quot;light&quot; data-overlaytextstyles=&quot;&amp;#123;&amp;quot;textColor&amp;quot;&amp;#58;&amp;quot;light&amp;quot;,&amp;quot;isBold&amp;quot;&amp;#58;false,&amp;quot;isItalic&amp;quot;&amp;#58;false,&amp;quot;textBoxColor&amp;quot;&amp;#58;&amp;quot;dark&amp;quot;,&amp;quot;textBoxOpacity&amp;quot;&amp;#58;0.54,&amp;quot;overlayColor&amp;quot;&amp;#58;&amp;quot;light&amp;quot;,&amp;quot;overlayTransparency&amp;quot;&amp;#58;0&amp;#125;&quot; data-siteid=&quot;4933b140-c91f-40a6-9786-f906dca179a1&quot; data-uniqueid=&quot;d2e989ff-a2c6-4e9a-9cbc-cca83f37f31e&quot; data-webid=&quot;651ea5e2-4134-4a54-bcfd-728ff02e3f5e&quot; data-height=&quot;175.39577039274923&quot; data-width=&quot;177&quot; data-widthpercentage=&quot;31.272084805653712&quot; data-uploading=&quot;0&quot;&gt;&lt;/div&gt;&lt;h2 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;text-align&amp;#58;center;&quot;&gt;&lt;span class=&quot;fontSizeXLargePlus&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;&lt;strong&gt;Your Feedback Fuels Our Growth.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;The feedback you give, not only provides us with valuable insights that guide ongoing improvements but also support better decision-making across the company.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;The survey helps us to&amp;#58;&lt;/span&gt;&lt;/p&gt;&lt;ul class=&quot;customListStyle&quot;&gt;&lt;li&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;Understand the pulse of the organization and how our people are feeling&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span class=&quot;fontColorThemeDark&quot;&gt;Uphold an ongoing dialogue between our leaders and employees&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpac