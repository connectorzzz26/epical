# Copy to .env and adjust. Do NOT commit your real .env.
# These are read by epical_agents/config.py (all optional — defaults shown).

AZURE_AI_PROJECT_ENDPOINT=https://genesismesh-resource.services.ai.azure.com/api/projects/genesismesh
EPICAL_AGENT_NAME=epical-na
EPICAL_NA_VERSION=1

# --- Authentication: choose ONE ---
# (A) API key — simplest. Calls go to {endpoint}/openai/v1 with this key.
# AZURE_AI_PROJECT_API_KEY=your-key-here
#
# (B) Microsoft Entra ID via DefaultAzureCredential — run `az login`, or set a
#     service principal. Used automatically when no API key is set.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
